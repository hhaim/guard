# Copy to `.env` and adjust (optional). Docker Compose reads this file automatically if present.
#
# POSTGRES_USER=guard
# POSTGRES_PASSWORD=guard
# POSTGRES_DB=guard
# POSTGRES_PORT=5432
#
# If you change Postgres credentials, set DATABASE_URL to match:
# DATABASE_URL=postgres://USER:PASSWORD@db:5432/DBNAME?sslmode=disable
#
# HTTP_PORT=8080
# CORS_ORIGIN=http://localhost:8080
# API_KEY=

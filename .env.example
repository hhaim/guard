# Copy to `.env` and adjust. Docker Compose reads this file automatically.
# Never commit `.env` (see .gitignore).

# Local Postgres (docker compose `db` service)
POSTGRES_USER=guard
POSTGRES_PASSWORD=guard
POSTGRES_DB=guard
POSTGRES_PORT=5432
DATABASE_URL=postgres://guard:guard@db:5432/guard?sslmode=disable

HTTP_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Clerk — https://dashboard.clerk.com/~/api-keys
# Quote values that end with $
CLERK_SECRET_KEY='sk_test_...'
BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
VITE_CLERK_PUBLISHABLE_KEY='pk_test_...'

# Verbose auth logs on API (docker compose logs api); 401 responses include jwt_verify_error
# AUTH_DEBUG=1

# Optional extra JWT azp origins (comma-separated). Dev defaults include :8080 and :5173.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Production: localhost JWT parties are auto-skipped when CORS_ORIGIN is https (non-localhost).
# Force-disable dev parties everywhere: CLERK_DEV_ORIGINS=0

# First hardened deploy: log CSP violations without blocking (remove after sign-in smoke test).
# CSP_REPORT_ONLY=1

# Legacy only when CLERK_SECRET_KEY is unset:
# API_KEY=

# --- Fly.io production (Neon DB; do not put Neon URL in local .env) ---
# Pooled connection: npx neonctl@latest connection-string --pooled  (sslmode=require)
# fly secrets set DATABASE_URL='postgres://...@...-pooler.../neondb?sslmode=require'
# fly secrets set CLERK_SECRET_KEY='sk_test_...' BOOTSTRAP_ADMIN_EMAIL='you@gmail.com' CORS_ORIGIN='https://your-app.fly.dev'
# fly deploy --build-arg VITE_CLERK_PUBLISHABLE_KEY='pk_test_...'
# Clerk Dashboard: allowed origins include https://your-app.fly.dev
# Do not set AUTH_DEBUG=1 on Fly. Optional first deploy: CSP_REPORT_ONLY=1 then remove after Clerk sign-in works.
# Verify: curl -sI https://your-app.fly.dev/ | grep -iE 'strict-transport|content-security|x-frame'
#         curl -s https://your-app.fly.dev/health   # {"status":"ok"} only

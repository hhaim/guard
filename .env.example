# Copy to `.env` and adjust. Docker Compose reads this file automatically.
# Never commit `.env` (see .gitignore).

# Local Postgres (docker compose `db` service)
POSTGRES_USER=guard
POSTGRES_PASSWORD=guard
POSTGRES_DB=guard
POSTGRES_PORT=5432
DATABASE_URL=postgres://guard:guard@db:5432/guard?sslmode=disable

HTTP_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Clerk — https://dashboard.clerk.com/~/api-keys
# Quote values that end with $
CLERK_SECRET_KEY='sk_test_...'
BOOTSTRAP_ADMIN_EMAIL=you@gmail.com
VITE_CLERK_PUBLISHABLE_KEY='pk_test_...'

# Legacy only when CLERK_SECRET_KEY is unset:
# API_KEY=
